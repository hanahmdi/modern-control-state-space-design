subplot(2,1,2)
plot(t,x_new2(4:6,:),'LineWidth',1.5)
grid on
title('Estimated States (Fast Observer)')
xlabel('Time (s)')
ylabel('Estimated States')

figure()
subplot(3,1,1)
plot(t,x_new2(1,:)-x_new2(4,:),'LineWidth',1.5)
grid on
title('Estimation Error of x_1')

subplot(3,1,2)
plot(t,x_new2(2,:)-x_new2(5,:),'LineWidth',1.5)
grid on
title('Estimation Error of x_2')

subplot(3,1,3)
plot(t,x_new2(3,:)-x_new2(6,:),'LineWidth',1.5)
grid on
title('Estimation Error of x_3')

%% Question 13

P = [C; [1 0 0]; [0 1 0]];

disp('Rank of Transformation Matrix P:')
disp(rank(P))

A_ro = P * A * inv(P);
B_ro = P * B;
C_ro = C * inv(P);
A_11 = A_ro(1,1);
A_12 = A_ro(1,2:3);
A_21 = A_ro(2:3,1);
A_22 = A_ro(2:3,2:3);
B_1 = B_ro(1,1);
B_2 = B_ro(2:3,1);
ro_p = [-1, -5];
L_t = place(A_22', A_12', ro_p);
L_ro = L_t';
ct = length(t);
xn = zeros(3, ct);
z = zeros(2, ct);
y_ro = zeros(1, ct);

xn(:,1) = [0; 0; 0];
z(:,1)  = [0; 0];

for k = 2:ct
    
    y_ro(k) = C_ro * xn(:,k-1); 
    xn(:,k) = xn(:,k-1) + 0.01 * (A_ro * xn(:,k-1) + B_ro);
    z(:,k) = z(:,k-1) + 0.01 * ((A_22 - L_ro * A_12) * z(:,k-1) + ...
                                ((A_22 - L_ro * A_12) * L_ro + A_21) * y_ro(k-1) + ...
                                (B_2 - L_ro * B_1));
end

x_actual = inv(P) * xn;

x_ro = (inv(P) * [[1 0 0]; [L_ro eye(2)]]) * [y_ro; z];

figure();
subplot(2,1,1);
plot(t, x_actual(1:3,:), 'LineWidth', 1.5);
title("Actual");
grid on;
legend('x_1', 'x_2', 'x_3');

subplot(2,1,2);
plot(t, x_ro, 'LineWidth', 1.5);

title("Estimated");
grid on;
legend('x_{est1}', 'x_{est2}', 'x_{est3}');

figure();

subplot(3,1,1);
plot(t, x_actual(1,:) - x_ro(1,:), 'k', 'LineWidth', 1.5);
title("Estimation Error x_1");
grid on;

subplot(3,1,2);
plot(t, x_actual(2,:) - x_ro(2,:), 'k', 'LineWidth', 1.5);
title("Estimation Error x_2");
grid on;

subplot(3,1,3);
plot(t, x_actual(3,:) - x_ro(3,:), 'k', 'LineWidth', 1.5);
title("Estimation Error x_3");
grid on;

%% Question 14

%% Question 14 - Observer-Based State Feedback (Regulator)

p_control = [-2, -3, -6];       
p_observer = [-10, -12, -15];  
K_comp = place(A, B, p_control);      
L_comp = acker(A', C', p_observer)';  
A_cl_pure = A - B * K_comp;
kr = 1 / (C * inv(-A_cl_pure) * B);

N = length(t);
x_sys = zeros(3, N);    
x_hat = zeros(3, N);   
y_comp = zeros(1, N);  
x_sys(:,1) = [0; 0; 0];
x_hat(:,1) = [0; 0; 0]; 

for k = 2:N
    
    u_comp = -K_comp * x_hat(:, k-1) + kr * 1; 
    x_sys(:, k) = x_sys(:, k-1) + 0.01 * (A * x_sys(:, k-1) + B * u_comp);
    y_comp(k-1) = C * x_sys(:, k-1);
    x_hat(:, k) = x_hat(:, k-1) + 0.01 * (A * x_hat(:, k-1) + B * u_comp + ...
                  L_comp * (y_comp(k-1) - C * x_hat(:, k-1)));
end

y_comp(N) = C * x_sys(:, N);

figure;
plot(t, y_comp, 'b', 'LineWidth', 2);
grid on;
title('Step Response of Observer-Based Closed-Loop System');
xlabel('Time (s)');
ylabel('Output (y)');

figure('Name', 'Question 14 - System States');

subplot(3,1,1);
plot(t, x_sys(1,:), 'b', t, x_hat(1,:), 'r--', 'LineWidth', 1.5);
grid on;
title('State x_1');
legend('Actual x_1', 'Estimated x_1');

subplot(3,1,2);
plot(t, x_sys(2,:), 'b', t, x_hat(2,:), 'r--', 'LineWidth', 1.5);
grid on;
title('State x_2');
legend('Actual x_2', 'Estimated x_2');

subplot(3,1,3);
plot(t, x_sys(3,:), 'b', t, x_hat(3,:), 'r--', 'LineWidth', 1.5);
grid on;
title('State x_3');
legend('Actual x_3', 'Estimated x_3');
xlabel('Time (s)');

%% Question 15
P = [C; [1 0 0]; [0 1 0]];
A_ro = P * A / P;
B_ro = P * B;
C_ro = C / P;

A_11 = A_ro(1,1);
A_12 = A_ro(1,2:3);
A_21 = A_ro(2:3,1);
A_22 = A_ro(2:3,2:3);
B_1 = B_ro(1,1);
B_2 = B_ro(2:3,1);

p_ctrl15 = [-3, -4, -5];
K15 = place(A, B, p_ctrl15);

p_obs15 = [-10, -12];
L_t15 = place(A_22', A_12', p_obs15);
L15 = L_t15';

A_cl_ideal = A - B * K15;
kr15 = 1 / (C * inv(-A_cl_ideal) * B);

D_red = A_22 - L15 * A_12;
F_red = D_red * L15 + A_21 - L15 * A_11;
G_red = B_2 - L15 * B_1;

N15 = length(t);
x_sys15 = zeros(3, N15);
z15 = zeros(2, N15);
x_hat15 = zeros(3, N15);
y15 = zeros(1, N15);

for k = 2:N15
    y_curr = C * x_sys15(:, k-1);
    y15(k-1) = y_curr;
    
    xb_hat = z15(:, k-1) + L15 * y_curr;
    x_hat15(:, k-1) = P \ [y_curr; xb_hat];
    
    u15 = -K15 * x_hat15(:, k-1) + kr15 * 1;
    
    x_sys15(:, k) = x_sys15(:, k-1) + 0.01 * (A * x_sys15(:, k-1) + B * u15);
    z15(:, k) = z15(:, k-1) + 0.01 * (D_red * z15(:, k-1) + F_red * y_curr + G_red * u15);
end

y15(N15) = C * x_sys15(:, N15);
xb_hat_final = z15(:, N15) + L15 * y15(N15);
x_hat15(:, N15) = P \ [y15(N15); xb_hat_final];
figure();
plot(t, y15, 'b', 'LineWidth', 2);
grid on;
title('Step Response (Reduced-Order Observer Feedback)');

figure();
subplot(3,1,1);
plot(t, x_sys15(1,:), 'b', t, x_hat15(1,:), 'r--', 'LineWidth', 1.5);
legend('Actual X1', 'Estimated X1');
grid on;

subplot(3,1,2);
plot(t, x_sys15(2,:), 'b', t, x_hat15(2,:), 'r--', 'LineWidth', 1.5);
legend('Actual X2', 'Estimated X2');
grid on;

subplot(3,1,3);
plot(t, x_sys15(3,:), 'b', t, x_hat15(3,:), 'r--', 'LineWidth', 1.5);
legend('Actual X3', 'Estimated X3');
grid on;

%% Questio  16


A_bar16 = [A zeros(3,1); -C 0];
B_bar16 = [B; 0];
p_track16 = [-3, -4, -5, -6];
K_int16 = acker(A_bar16, B_bar16, p_track16);
K_sys16 = K_int16(1:3);
K_i16 = K_int16(4);
p_obs16 = [-10, -12, -15];
L16 = acker(A', C', p_obs16)';
N16 = length(t);
x_sys16 = zeros(3, N16);
x_hat16 = zeros(3, N16);
xi16 = zeros(1, N16);
y16 = zeros(1, N16);

for k = 2:N16
    y_curr = C * x_sys16(:, k-1);
    y16(k-1) = y_curr;
    
    u16 = -K_sys16 * x_hat16(:, k-1) - K_i16 * xi16(k-1);
    
    x_sys16(:, k) = x_sys16(:, k-1) + 0.01 * (A * x_sys16(:, k-1) + B * u16);
    x_hat16(:, k) = x_hat16(:, k-1) + 0.01 * (A * x_hat16(:, k-1) + B * u16 + L16 * (y_curr - C * x_hat16(:, k-1)));
    xi16(k) = xi16(k-1) + 0.01 * (1 - y_curr);
end

y16(N16) = C * x_sys16(:, N16);

figure();
plot(t, y16, 'LineWidth', 2);
title('Step Response (Integral Tracker with Full-Order Observer)');
grid on;

figure();
subplot(3,1,1);
plot(t, x_sys16(1,:), 'b', t, x_hat16(1,:), 'r--', 'LineWidth', 1.5);
legend('Actual X1', 'Estimated X1');
grid on;

subplot(3,1,2);
plot(t, x_sys16(2,:), 'b', t, x_hat16(2,:), 'r--', 'LineWidth', 1.5);
legend('Actual X2', 'Estimated X2');
grid on;

subplot(3,1,3);
plot(t, x_sys16(3,:), 'b', t, x_hat16(3,:), 'r--', 'LineWidth', 1.5);
legend('Actual X3', 'Estimated X3');
grid on;

%% Question 17

P = [C; [1 0 0]; [0 1 0]];
A_ro = P * A / P;
B_ro = P * B;
C_ro = C / P;
A_11 = A_ro(1,1);
A_12 = A_ro(1,2:3);
A_21 = A_ro(2:3,1);
A_22 = A_ro(2:3,2:3);
B_1 = B_ro(1,1);
B_2 = B_ro(2:3,1);
p_obs17 = [-10, -12];
L_t17 = place(A_22', A_12', p_obs17);
L17 = L_t17';
D_red17 = A_22 - L17 * A_12;
F_red17 = D_red17 * L17 + A_21 - L17 * A_11;
G_red17 = B_2 - L17 * B_1;
A_bar17 = [A zeros(3,1); -C 0];
B_bar17 = [B; 0];
p_track17 = [-3, -4, -5, -6];
K_int17 = acker(A_bar17, B_bar17, p_track17);
K_sys17 = K_int17(1:3);
K_i17 = K_int17(4);

N17 = length(t);
x_sys17 = zeros(3, N17);
z17 = zeros(2, N17);
x_hat17 = zeros(3, N17);
xi17 = zeros(1, N17);
y17 = zeros(1, N17);

for k = 2:N17
    y_curr = C * x_sys17(:, k-1);
    y17(k-1) = y_curr;
    
    xb_hat = z17(:, k-1) + L17 * y_curr;
    x_hat17(:, k-1) = P \ [y_curr; xb_hat];
    
    u17 = -K_sys17 * x_hat17(:, k-1) - K_i17 * xi17(k-1);
    
    x_sys17(:, k) = x_sys17(:, k-1) + 0.01 * (A * x_sys17(:, k-1) + B * u17);
    z17(:, k) = z17(:, k-1) + 0.01 * (D_red17 * z17(:, k-1) + F_red17 * y_curr + G_red17 * u17);
    xi17(k) = xi17(k-1) + 0.01 * (1 - y_curr);
end

y17(N17) = C * x_sys17(:, N17);
xb_hat_final = z17(:, N17) + L17 * y17(N17);
x_hat17(:, N17) = P \ [y17(N17); xb_hat_final];

figure();
plot(t, y17, 'LineWidth', 2);
title('Step Response (Integral Tracker with Reduced-Order Observer)');
grid on;

figure();
subplot(3,1,1);
plot(t, x_sys17(1,:), 'b', t, x_hat17(1,:), 'r--', 'LineWidth', 1.5);
legend('Actual X1', 'Estimated X1');
grid on;

subplot(3,1,2);
plot(t, x_sys17(2,:), 'b', t, x_hat17(2,:), 'r--', 'LineWidth', 1.5);
legend('Actual X2', 'Estimated X2');
grid on;

subplot(3,1,3);
plot(t, x_sys17(3,:), 'b', t, x_hat17(3,:), 'r--', 'LineWidth', 1.5);
legend('Actual X3', 'Estimated X3');
grid on;

